<!-- Bounded reverse recovery; all motion uses LiDAR collision checks and the common drive bridge. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateWithReverseRecovery">
    <PipelineSequence name="NavigateBasic">
      <RateController hz="1.0">
        <RecoveryNode number_of_retries="1" name="PlanWithClear">
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
    </PipelineSequence>
      <Sequence name="BackOutAndReplan">
        <Wait wait_duration="1"/>
        <BackUp backup_dist="0.35" backup_speed="0.12" time_allowance="12.0"/>
        <Wait wait_duration="1"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
