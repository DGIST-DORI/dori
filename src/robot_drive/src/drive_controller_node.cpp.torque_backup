    joint_state_sub_ = create_subscription<sensor_msgs::msg::JointState>(
      "/joint_states", 50,
      std::bind(&DriveControllerNode::jointStateCallback, this, std::placeholders::_1));

    left_effort_pub_ = create_publisher<std_msgs::msg::Float64MultiArray>(
      "/left_bldc_effort_controller/commands", 20);
    right_effort_pub_ = create_publisher<std_msgs::msg::Float64MultiArray>(
      "/right_bldc_effort_controller/commands", 20);

    drive_feedback_pub_ = create_publisher<robot_msgs::msg::CommandFeedback>(
      "/drive/command_feedback", 20);

    current_linear_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/current_linear", 20);
    current_angular_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/current_angular", 20);
    linear_accel_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/linear_accel_ref", 20);
    left_v_ref_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/left_v_ref", 20);
    right_v_ref_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/right_v_ref", 20);
    left_speed_pi_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/left_speed_pi_torque", 20);
    right_speed_pi_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/right_speed_pi_torque", 20);
    left_start_boost_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/left_start_boost_torque", 20);
    right_start_boost_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/right_start_boost_torque", 20);
    left_friction_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/left_friction_torque", 20);
    right_friction_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/right_friction_torque", 20);

    left_stuck_recovery_debug_pub_ =
      create_publisher<std_msgs::msg::Float64>(
        "/drive/debug/left_stuck_recovery_torque", 20);

    right_stuck_recovery_debug_pub_ =
      create_publisher<std_msgs::msg::Float64>(
        "/drive/debug/right_stuck_recovery_torque", 20);
    left_stop_catch_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/left_stop_catch_torque", 20);
    right_stop_catch_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
      "/drive/debug/right_stop_catch_torque", 20);
    stop_catch_debug_pub_ = create_publisher<std_msgs::msg::Float64>(
