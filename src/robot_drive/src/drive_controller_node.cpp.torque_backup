namespace
{
constexpr double kEps = 1e-9;
constexpr double kNormalizedCmdMin = -1.0;
constexpr double kNormalizedCmdMax = 1.0;
constexpr int TF_RUNNING = 1;
constexpr int TF_PAUSED = 2;

double signOf(double x)
{
  if (x > 0.0) return 1.0;
  if (x < 0.0) return -1.0;
  return 0.0;
}
}  // namespace

class DriveControllerNode : public rclcpp::Node
{
public:
  DriveControllerNode()
  : Node("drive_controller_node")
  {
    wheel_radius_ = declare_parameter<double>("wheel_radius", 0.25);
    wheel_separation_ = declare_parameter<double>("wheel_separation", 0.60);
    max_linear_velocity_ = declare_parameter<double>("max_linear_velocity", 1.72);
    max_angular_velocity_ = declare_parameter<double>("max_angular_velocity", 1.20);

    linear_accel_limit_ = declare_parameter<double>("linear_accel_limit", 0.50);
    linear_decel_limit_ = declare_parameter<double>("linear_decel_limit", 0.40);
    linear_jerk_limit_ = declare_parameter<double>("linear_jerk_limit", 1.50);

    angular_accel_limit_ = declare_parameter<double>("angular_accel_limit", 1.00);
    angular_decel_limit_ = declare_parameter<double>("angular_decel_limit", 0.80);
    angular_jerk_limit_ = declare_parameter<double>("angular_jerk_limit", 3.00);

    speed_kp_ = declare_parameter<double>("speed_kp", 0.5);
    speed_ki_ = declare_parameter<double>("speed_ki", 0.0);
    speed_integral_limit_ = declare_parameter<double>("speed_integral_limit", 4.0);

    // When the wheel reference is effectively zero, disable the
    // speed PI completely. This prevents encoder noise around zero
    // from producing alternating +/- torque and audible chatter.
    zero_pi_reference_threshold_ =
      declare_parameter<double>("zero_pi_reference_threshold", 0.05);

    accel_ff_enabled_ = declare_parameter<bool>("accel_ff_enabled", true);
    wheel_accel_ff_gain_ = declare_parameter<double>("wheel_accel_ff_gain", 0.0);
    accel_ff_torque_limit_ = declare_parameter<double>("accel_ff_torque_limit", 3.0);

    // Running friction assist: keeps a small torque in the commanded
    // direction after START_BOOST releases, preventing low-speed stick-slip.
    running_friction_enabled_ = declare_parameter<bool>("running_friction_enabled", true);
    left_running_friction_torque_ =
      declare_parameter<double>(
        "left_running_friction_torque",
        3.0);

    right_running_friction_torque_ =
      declare_parameter<double>(
        "right_running_friction_torque",
        4.5);
    running_friction_min_ref_ = declare_parameter<double>("running_friction_min_ref", 0.10);
    running_friction_low_speed_ref_ = declare_parameter<double>("running_friction_low_speed_ref", 0.80);
    running_friction_low_speed_gain_ = declare_parameter<double>("running_friction_low_speed_gain", 1.0);
    running_friction_high_speed_gain_ = declare_parameter<double>("running_friction_high_speed_gain", 0.5);

    // ========================================================
    // STUCK RECOVERY
    // ========================================================
    stuck_recovery_enabled_ =
      declare_parameter<bool>("stuck_recovery_enabled", true);

    stuck_ref_threshold_ =
      declare_parameter<double>("stuck_ref_threshold", 0.30);

    stuck_actual_threshold_ =
      declare_parameter<double>("stuck_actual_threshold", 0.30);

    stuck_velocity_ratio_threshold_ =
      declare_parameter<double>("stuck_velocity_ratio_threshold", 0.35);

    stuck_detect_hold_sec_ =
      declare_parameter<double>("stuck_detect_hold_sec", 0.20);

    stuck_recovery_initial_torque_ =
      declare_parameter<double>("stuck_recovery_initial_torque", 0.5);

    stuck_recovery_max_torque_ =
      declare_parameter<double>("stuck_recovery_max_torque", 8.0);

    stuck_recovery_ramp_rate_ =
      declare_parameter<double>("stuck_recovery_ramp_rate", 3.0);

    stuck_recovery_release_velocity_ =
      declare_parameter<double>("stuck_recovery_release_velocity", 0.50);

    stuck_recovery_release_hold_sec_ =
      declare_parameter<double>("stuck_recovery_release_hold_sec", 0.10);

    stuck_recovery_handover_rate_ =
      declare_parameter<double>("stuck_recovery_handover_rate", 3.0);

    stuck_recovery_timeout_sec_ =
      declare_parameter<double>("stuck_recovery_timeout_sec", 2.0);

    start_boost_enabled_ = declare_parameter<bool>("start_boost_enabled", true);
    start_command_threshold_ = declare_parameter<double>("start_command_threshold", 0.20);
    start_stuck_velocity_threshold_ = declare_parameter<double>("start_stuck_velocity_threshold", 0.10);
    start_release_velocity_ = declare_parameter<double>("start_release_velocity", 0.30);
    start_release_hold_sec_ = declare_parameter<double>("start_release_hold_sec", 0.10);
    start_boost_initial_torque_ = declare_parameter<double>("start_boost_initial_torque", 2.0);
    start_boost_max_torque_ = declare_parameter<double>("start_boost_max_torque", 10.0);
    start_boost_ramp_rate_ = declare_parameter<double>("start_boost_ramp_rate", 8.0);
    start_boost_handover_rate_ = declare_parameter<double>("start_boost_handover_rate", 5.0);
    start_boost_timeout_sec_ = declare_parameter<double>("start_boost_timeout_sec", 2.0);

    stop_catch_enabled_ = declare_parameter<bool>("stop_catch_enabled", true);
    stop_command_threshold_ = declare_parameter<double>("stop_command_threshold", 0.02);
    stop_reference_threshold_ = declare_parameter<double>("stop_reference_threshold", 0.03);
    stop_wheel_velocity_threshold_ = declare_parameter<double>("stop_wheel_velocity_threshold", 0.15);
    stop_reverse_torque_ = declare_parameter<double>("stop_reverse_torque", 2.0);
    stop_reverse_ramp_rate_ = declare_parameter<double>("stop_reverse_ramp_rate", 20.0);
    stop_reverse_speed_limit_ = declare_parameter<double>("stop_reverse_speed_limit", 0.40);
    stop_catch_duration_sec_ = declare_parameter<double>("stop_catch_duration_sec", 0.25);
    stop_catch_timeout_sec_ = declare_parameter<double>("stop_catch_timeout_sec", 0.70);

    stabilization_torque_limit_ = declare_parameter<double>("stabilization_torque_limit", 10.0);
    stabilization_timeout_sec_ = declare_parameter<double>("stabilization_timeout_sec", 0.10);

    final_torque_limit_ = declare_parameter<double>("final_torque_limit", 13.0);
    final_torque_slew_rate_ = declare_parameter<double>("final_torque_slew_rate", 30.0);

    left_joint_name_ = declare_parameter<std::string>("left_joint_name", "left_wheel_joint");
    right_joint_name_ = declare_parameter<std::string>("right_joint_name", "right_wheel_joint");
    joint_state_timeout_sec_ = declare_parameter<double>("joint_state_timeout_sec", 0.20);
