<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dori_bt</name>
  <version>0.0.0</version>
  <description>BehaviorTree.CPP execution package for Dori Guide Robot</description>
  <maintainer email="user@todo.todo">TODO</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 Core -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>

  <!-- BehaviorTree.CPP v4 -->
  <depend>behaviortree_cpp</depend>

  <!-- Dori Custom Messages (LLMQuery, Speak 등) -->
  <depend>dori_msgs</depend>

  <!-- Nav2 BT Plugins (주행 연동을 위해 권장) -->
  <depend>nav2_behavior_tree</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>