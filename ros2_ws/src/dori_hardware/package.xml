<?xml version="1.0"?>
<package format="3">
  <name>dori_hardware</name>
  <version>0.1.0</version>
  <description>DORI physical hardware configuration, communication bridges, and interfaces.</description>
  <maintainer email="maintainers@dgist-dori.xyz">DORI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dori_msgs</depend>
  <depend>dynamixel_sdk_custom_interfaces</depend>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>dynamixel_sdk_examples</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>