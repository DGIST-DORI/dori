<?xml version="1.0"?>
<package format="3">
  <name>dori_hardware</name>
  <version>0.1.0</version>
  <description>DORI physical hardware configuration, communication bridges, and interfaces.</description>
  <maintainer email="maintainers@dgist-dori.xyz">DORI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dori_msgs</depend>
  <depend>dynamixel_sdk_custom_interfaces</depend>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>dynamixel_sdk_examples</exec_depend>
  <exec_depend>cubemars_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>dori_control</exec_depend>
  <exec_depend>dori_supervisor</exec_depend>
  <exec_depend>dori_diagnostics</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
