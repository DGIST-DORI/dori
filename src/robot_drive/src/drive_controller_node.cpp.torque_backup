    right_start_boost_ = WheelStartBoost{};
    stop_requested_ = false;
    stop_catch_active_ = false;
    stop_catch_torque_ = 0.0;
    stabilization_torque_ = 0.0;
    stabilization_received_ = false;
    previous_left_final_torque_ = previous_right_final_torque_ = 0.0;
    controller_state_ = ControllerState::IDLE;
  }

